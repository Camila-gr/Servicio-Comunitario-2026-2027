# Plantilla de configuración — este archivo SÍ se sube a git.
# Copia este archivo a .env y completa los valores reales.
#   cp .env.example .env
# Luego genera la configuración del sitio:
#   npm run config

# --- Sitio (público: la anon key es visible en el navegador, no es secreta) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui

